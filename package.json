{
  "name": "fantrade",
  "version": "0.2.0",
  "description": "Fantrade - Football Ownership Economy Platform",
  "type": "module",
  "main": "dist/api/server.js",
  "scripts": {
    "db:start": "tsx src/database/run-db.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "dev:api": "tsx watch src/api/server.ts",
    "dev": "tsx src/scripts/dev.ts",
    "build": "tsc",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "reconcile": "tsx src/scripts/reconcile.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
